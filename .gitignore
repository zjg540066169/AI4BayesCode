# ── OS / editor ───────────────────────────────────────────────
.DS_Store
*~
.idea/
.vscode/

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.venv/
venv/

# ── R ─────────────────────────────────────────────────────────
.Rproj.user/
.Rhistory
.RData
.Ruserdata
*.Rproj
Rplots.pdf
r-pkg/src/*.o
r-pkg/src/*.so
r-pkg/src/*.dll
r-pkg/..Rcheck/
r-pkg/*.tar.gz

# ── generated / build outputs ─────────────────────────────────
generated/
PROMPT.txt
*.tar.gz
*.whl

# ── backups / archives (never commit) ─────────────────────────
*.bak
*.bak.*
*.bak_*
*.orig
*_BACKUP_*
*_DRAFT.md
_archive/
# macOS / iCloud duplication artifacts ("foo 2.hpp", "foo 2.txt", ...).
# NB: unquoted -- .gitignore treats quotes as literal, so the old "* 2.md" never matched.
# Match any " <digit>" suffix: Finder numbers duplicates 2, 3, 4, ... and the
# " 3." wave already reached the shipped python package.
* [0-9].*
* [0-9]
# stray one-off dev backups (e.g. old NUTS-kernel experiments)
*.optA
*.patched
*.cache_v1_broken

# ── logs + compiled test binaries (sources + Makefile stay tracked) ──
*.log
tests/test_*
!tests/test_*.cpp
!tests/test_*.h
!tests/test_*.hpp
!tests/test_*.R

# R CMD check / build artifacts
*.Rcheck/
AI4BayesCode_*.tar.gz

# Harness result dumps: tests_autodiff/*.R saveRDS() their summaries into the
# repo root, so running the suite would otherwise dirty the tree.
*.rds

# Paper-experiment protocol and local-tier blocks: LOCAL ONLY, never published.
# tools/sync.sh already keeps these out of the two installable packages; these
# entries keep them out of the repo itself. Case variants are spelled out
# because git's ignore patterns are case-sensitive while macOS's filesystem
# is not, so SIM2.md would otherwise slip past a lone sim[0-9]* rule.
# sim[0-9]*, not sim*: a catalogue card named simplex_*_block.md is product.
skills/sim[0-9]*
skills/SIM[0-9]*
skills/Sim[0-9]*
blocks_local/
