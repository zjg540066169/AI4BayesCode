# Ship the vendored AI4BayesCode C++ header tree inside the sdist + wheel so
# that source() is self-contained (no checkout required).
graft AI4BayesCode/_vendored_include
graft AI4BayesCode/_skills
graft AI4BayesCode/_examples
include AI4BayesCode/start.md
include LICENSE
include THIRD_PARTY_LICENSES.md
global-exclude *.bak*
# NOTE: a MANIFEST.in pattern must NOT contain a space -- setuptools
# splits on whitespace, so `global-exclude * [0-9].*` becomes the two
# patterns `*` and `[0-9].*`, and the bare `*` deletes EVERY file the
# grafts above added (measured: 953 entries -> 7, an empty package).
# Finder's "foo 2.py" duplicates are handled by .gitignore instead.
global-exclude *.pyc
global-exclude __pycache__/*
global-exclude .DS_Store
